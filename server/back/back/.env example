# Express
EXPRESS_PORT=3000

# JWT
# Replace with a unique, randomly generated secret before running the server.
SECRET=replace-with-a-long-random-secret
API_SECURED=true
TOKEN_CADUCITY='48h'
ROUTES_WHITELIST='/api/persons/authenticate,/api/places/authenticate'

# PostgreSQL
# dialect and schema are optional. If undefined, they equal 'postgres' and 'elliot', respectively.
# If alter is true, force and drop schema are always ignored to prevent app crashing
SEQUELIZE_DIALECT=postgres
SEQUELIZE_DB=postgres
SEQUELIZE_USER=postgres
SEQUELIZE_PASS=password
SEQUELIZE_HOST=localhost
SEQUELIZE_PORT=5432
SEQUELIZE_SCHEMA=public
# Optional: add missing example sensors, outputs, and alarms without overwriting existing records.
SEQUELIZE_SEED_INITIAL_DATA=false
LIST_LIMIT=10000

# Program configuration
SIMULATE_PLACES=true